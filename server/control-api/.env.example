# Copy this file to .env and replace the placeholders.
# Never commit a real .env, database password, or connection URL.

POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-local-secret
POSTGRES_DB=replace-with-db-name
# Optional 64-character hex key used to encrypt AI/RTC secrets in PostgreSQL.
# Leave empty until you save settings; PUT /api/v1/admin/settings/* then returns 503.
# SETTINGS_MASTER_KEY=
# Optional LiveKit profile for the self-hosted subtitle line.
# docker compose --profile livekit up -d livekit
# Dev keys match LiveKit --dev. Replace before production.
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# LIVEKIT_ASR_BASE_URL=
# LIVEKIT_ASR_API_KEY=
# LIVEKIT_ASR_MODEL=whisper-1
# Optional resume knowledge index (TEI + pgvector). control-api starts even if embedding is still downloading weights.
# KNOWLEDGE_PROVIDER=local-pgvector
# EMBEDDING_MODEL=BAAI/bge-m3
# Host-only default if you publish TEI yourself; compose uses http://embedding:80 and does not map a host port.
# EMBEDDING_BASE_URL=http://127.0.0.1:8090
# Desktop speech fallback is configured on the client, not here.

# Optional MCP service (control-api-mcp): docker compose --profile mcp up -d control-api-mcp
# Bearer token required by MCP clients in Authorization: Bearer <token>.
# MCP_ADMIN_TOKEN=replace-with-mcp-token
# Existing active administrator username every MCP tool call is attributed to.
# MCP_ACTOR_USERNAME=
# MCP_LISTEN_ADDRESS=127.0.0.1:8091

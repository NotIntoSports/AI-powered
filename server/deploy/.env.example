POSTGRES_USER=replace-with-db-user
POSTGRES_PASSWORD=replace-with-db-secret
POSTGRES_DB=replace-with-db-name
DATABASE_URL=postgres://replace-with-db-user:replace-with-db-secret@postgres:5432/replace-with-db-name?sslmode=disable
# First administrator seeded on control-api start when no admin exists.
# Changing these later does not overwrite an already-created admin password.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=adminqaz
# 64 hex characters. Required before saving AI/RTC secrets.
SETTINGS_MASTER_KEY=
# Optional LiveKit profile: docker compose --profile livekit up -d
# RTC product path is LiveKit-only (火山 RTC removed). Dev keys are LiveKit --dev defaults.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Agent loads speech/pipeline/AI from control-api when set (must match control-api).
AGENT_INTERNAL_TOKEN=
LIVEKIT_ASR_BASE_URL=
LIVEKIT_ASR_API_KEY=
LIVEKIT_ASR_MODEL=whisper-1
LIVEKIT_ASR_LANGUAGE=zh
# Resume knowledge index. Compose talks to the internal embedding service; do not publish its port.
KNOWLEDGE_PROVIDER=local-pgvector
EMBEDDING_MODEL=BAAI/bge-m3
# Optional MCP profile: docker compose --profile mcp up -d
# Bearer token required by MCP clients in Authorization: Bearer <token>.
MCP_ADMIN_TOKEN=
# Existing active administrator username every MCP tool call is attributed to.
MCP_ACTOR_USERNAME=

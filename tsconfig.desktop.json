{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "dist-desktop",
    "rootDir": "desktop",
    "noEmit": false,
    "isolatedModules": false,
    "allowImportingTsExtensions": false
  },
  "include": ["desktop/**/*.ts"],
  "exclude": ["desktop/rtc/**"]
}

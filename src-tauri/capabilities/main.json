{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimum permissions for the local foundation window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-foundation-get-status",
    "allow-diagnostics-export",
    "allow-config-get-startup-state",
    "allow-config-get-public",
    "allow-config-restore-last-good",
    "allow-config-restore-defaults",
    "allow-open-app-directory",
    "allow-model-provider-save",
    "allow-model-provider-test",
    "allow-model-provider-discover",
    "allow-model-provider-activate",
    "allow-model-provider-delete",
    "allow-speech-route-save",
    "allow-speech-route-test",
    "allow-speech-route-activate",
    "allow-speech-route-delete",
    "allow-role-profile-save",
    "allow-role-profile-copy",
    "allow-role-profile-activate",
    "allow-role-profile-delete",
    "allow-embedding-config-save",
    "allow-embedding-config-test",
    "allow-embedding-config-activate",
    "allow-embedding-config-delete",
    "allow-livekit-settings-save",
    "allow-livekit-settings-test",
    "allow-livekit-settings-enable"
  ]
}

# 仅填写在复制后的 .env.local 中；不要把真实密钥写回此模板。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# 可选：追问与纪要的最长等待时间（毫秒）
MODEL_QUESTION_TIMEOUT_MS=60000
MODEL_REPORT_TIMEOUT_MS=180000
# 可选：Windows 系统语音子进程最长等待时间（毫秒）
SAPI_SYNTHESIS_TIMEOUT_MS=30000
SAPI_VOICE_LIST_TIMEOUT_MS=10000

# 方案一：复用 OpenAI-compatible 音频转写
TRANSCRIPTION_PROVIDER=openai
# 转写地址与模型地址不同时必须填写该转写服务自己的密钥
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TRANSCRIPTION_LANGUAGE=zh

# 方案二：本地 whisper.cpp（将 TRANSCRIPTION_PROVIDER 改为 whisper-cpp）
WHISPER_CPP_URL=http://127.0.0.1:8080/inference

# 管理端地址，仅用于客户端上传简历。不要把腾讯云密钥写在这里。
CONTROL_API_ORIGIN=

# 豆包语音（声音复刻 / TTS / 录音转写）本机回退。真实密钥只写 .env.local 或管理后台。
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
VOLCENGINE_SPEECH_SPEAKER_ID=

# 阿里云智能语音交互（NLS）。Appkey 来自语音控制台项目；Token 用 RAM AccessKey 调用 CreateToken。
# 配齐后优先于豆包语音用于舞台 TTS 和一句话识别。声音复刻仍走豆包。
SPEECH_PROVIDER=auto
ALIYUN_NLS_APPKEY=
ALIYUN_NLS_ACCESS_KEY_ID=
ALIYUN_NLS_ACCESS_KEY_SECRET=
ALIYUN_NLS_TOKEN=
ALIYUN_NLS_VOICE=xiaoyun
ALIYUN_NLS_GATEWAY=https://nls-gateway-cn-shanghai.aliyuncs.com

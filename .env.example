# 仅填写在复制后的 .env.local 中；不要把真实密钥写回此模板。
# 可选：Windows 系统语音子进程最长等待时间（毫秒）
SAPI_SYNTHESIS_TIMEOUT_MS=30000
SAPI_VOICE_LIST_TIMEOUT_MS=10000

# 豆包语音（声音复刻 / TTS）本机回退。真实密钥只写 .env.local 或管理后台。
VOLCENGINE_SPEECH_API_KEY=
VOLCENGINE_SPEECH_APP_ID=
VOLCENGINE_SPEECH_ACCESS_TOKEN=
VOLCENGINE_SPEECH_SPEAKER_ID=

# 阿里云智能语音交互（NLS）。Appkey 来自语音控制台项目；Token 用 RAM AccessKey 调用 CreateToken。
# 配齐后优先于豆包语音用于客户端试听和声音复刻。声音复刻：豆包不可用时自动走阿里云 CosyVoice
# （复刻音色自动分配，无需手工填 ID；音频经管理端腾讯云 COS 中转，COS 在管理后台配置，本机无新变量）。
SPEECH_PROVIDER=auto
ALIYUN_NLS_APPKEY=
ALIYUN_NLS_ACCESS_KEY_ID=
ALIYUN_NLS_ACCESS_KEY_SECRET=
ALIYUN_NLS_TOKEN=
ALIYUN_NLS_VOICE=xiaoyun
ALIYUN_NLS_GATEWAY=https://nls-gateway-cn-shanghai.aliyuncs.com

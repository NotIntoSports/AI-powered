{
  "name": "authorized-interview-screen-helper",
  "version": "0.1.0",
  "description": "Windows desktop client for local AI Virtual Assistant interactions",
  "author": "AI Virtual Assistant contributors",
  "private": true,
  "main": "dist-desktop/main.js",
  "scripts": {
    "prepare:vad": "node scripts/copy-vad-assets.mjs",
    "measure:legacy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/measure-desktop-baseline.ps1",
    "dev:tauri-ui": "vite --config vite.config.ts",
    "build:tauri-ui": "tsc -p tsconfig.tauri.json && vite build --config vite.config.ts",
    "test:tauri-ui": "vitest run --config vite.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "predev": "npm run prepare:vad",
    "dev": "next dev -H 127.0.0.1",
    "prebuild": "npm run prepare:vad",
    "build": "next build",
    "build:standalone": "node scripts/build-next-standalone.mjs",
    "build:desktop": "tsc -p tsconfig.desktop.json",
    "build:audio-bridge": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-audio-bridge.ps1 -RunTests",
    "prepare:prerequisites": "pwsh.exe -NoProfile -File scripts/fetch-prerequisites.ps1",
    "package:smoke": "npm run build:standalone && npm run build:desktop && npm run build:audio-bridge && electron-builder --dir --win --x64 && npm run test:packaged-runtime",
    "make:windows": "npm run build && npm run build:standalone && npm run build:desktop && npm run build:audio-bridge && npm run prepare:prerequisites && electron-builder --win nsis --x64 && npm run test:packaged-runtime",
    "test:desktop-shell": "node --no-warnings --experimental-strip-types --test tests/desktop/*.test.mjs",
    "test:packaged-runtime": "node scripts/test-packaged-runtime.mjs",
    "test:livekit-smoke": "node scripts/smoke-livekit.mjs",
    "test:livekit-load": "node scripts/load-livekit-audio.mjs",
    "start": "next start -H 127.0.0.1",
    "test:transcription-turn": "node scripts/test-transcription-turn.mjs",
    "test:auto-answer-submit": "node scripts/test-auto-answer-submit.mjs",
    "test:audio": "node scripts/test-audio-devices.mjs",
    "test:virtual-audio-install": "node --no-warnings --experimental-strip-types scripts/smoke-virtual-audio-install.mjs",
    "test:speech": "node scripts/test-volcengine-speech.mjs && node scripts/test-aliyun-nls.mjs",
    "test:aliyun-nls": "node scripts/test-aliyun-nls.mjs",
    "test:aliyun-nls-smoke": "node scripts/smoke-aliyun-nls.mjs",
    "test:audio-signal": "node scripts/test-audio-signal.mjs",
    "test:tts-error": "node scripts/test-tts-error.mjs",
    "test:echo-guard": "node scripts/test-echo-guard.mjs",
    "test:windows-stdio": "node scripts/test-windows-stdio.mjs",
    "test:launchers": "node scripts/test-windows-launchers.mjs",
    "test:node-setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-ensure-node.ps1",
    "test:request-timeout": "node scripts/test-request-timeout.mjs",
    "test:export": "node scripts/test-interview-export.mjs",
    "test:obs": "node scripts/test-obs-service.mjs",
    "test:camera": "node scripts/test-virtual-camera-device.mjs",
    "test:readiness": "node --no-warnings --experimental-strip-types scripts/test-interview-readiness.mjs",
    "test:readiness-snapshot": "node --no-warnings --experimental-strip-types scripts/test-readiness-snapshot.mjs",
    "test:meeting-handoff": "node --no-warnings --experimental-strip-types scripts/test-meeting-handoff.mjs",
    "test:origin": "node scripts/test-request-origin.mjs",
    "test:security-headers": "node scripts/smoke-security-headers.mjs",
    "test:session": "node scripts/smoke-session-persistence.mjs",
    "check:environment": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-environment.ps1",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "start:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "stop:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/stop-windows.ps1"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "@tauri-apps/api": "2.11.1",
    "livekit-client": "2.21.0",
    "next": "^15.4.0",
    "obs-websocket-js": "^5.0.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.0.0",
    "typescript": "5.8.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
